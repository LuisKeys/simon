# Provider API keys (optional)
OPENAI_API_KEY=
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional Ollama host
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:12b-mlx

# auto, or an specific model like gpt-5, claude-3-5-sonnet-latest, ollama, llama3.1
DEFAULT_MODEL=auto

# Knowledge backend: vector (default, embeddings + SIDX index) | router
# (hierarchical/lexical, no embeddings) | hybrid (reserved, not implemented)
# KNOWLEDGE_MODE=vector
# KNOWLEDGE_ROUTER_PATH=.simon_knowledge_router
# KNOWLEDGE_ROUTER_MAX_CATEGORIES=3
# KNOWLEDGE_ROUTER_MAX_DOCUMENTS=5
# KNOWLEDGE_ROUTER_MAX_SECTIONS=5
# KNOWLEDGE_ROUTER_MIN_CATEGORY_SCORE=0.05
# KNOWLEDGE_ROUTER_MIN_DOCUMENT_SCORE=0.05
# KNOWLEDGE_ROUTER_MIN_SECTION_SCORE=0.05
# KNOWLEDGE_ROUTER_STRICT=false

# Folders the agent is allowed to index for knowledge (true/false per folder)
ENABLE_DIR_DOCUMENTS=true
ENABLE_DIR_DOWNLOADS=true
ENABLE_DIR_PICTURES=false
ENABLE_DIR_DESKTOP=false

# Logging (disabled by default)
# SIMON_LOGGING_ENABLED=true
# SIMON_LOG_LEVEL=INFO   # DEBUG | INFO | WARNING

